    "components": {
        "schemas": {
            "Olympiad": {
                "required": [
                    "name",
                    "description",
                    "start_date",
                    "end_date"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Olimpiada de Matemáticas 2025"
                    },
                    "description": {
                        "type": "string",
                        "example": "Competencia nacional de matemáticas"
                    },
                    "start_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-01-01"
                    },
                    "end_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-12-31"
                    }
                },
                "type": "object"
            },
            "Area": {
                "required": [
                    "name",
                    "description"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Matemáticas"
                    },
                    "description": {
                        "type": "string",
                        "example": "Área de matemáticas"
                    }
                },
                "type": "object"
            },
            "Phase": {
                "required": [
                    "name",
                    "description",
                    "start_date",
                    "end_date"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Fase Clasificatoria"
                    },
                    "description": {
                        "type": "string",
                        "example": "Primera fase de la olimpiada"
                    },
                    "start_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-01-01"
                    },
                    "end_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-02-28"
                    }
                },
                "type": "object"
            },
            "CompetitorRowError": {
                "required": [
                    "message"
                ],
                "properties": {
                    "row": {
                        "description": "Número de fila en el CSV (1-index).",
                        "type": "integer",
                        "example": 5,
                        "nullable": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Faltan campos obligatorios en la fila."
                    }
                },
                "type": "object"
            },
            "CompetitorStats": {
                "required": [
                    "processed",
                    "created_contestants",
                    "updated_contestants",
                    "created_inscriptions",
                    "skipped_duplicate_area",
                    "errors"
                ],
                "properties": {
                    "processed": {
                        "type": "integer",
                        "example": 12
                    },
                    "created_contestants": {
                        "type": "integer",
                        "example": 8
                    },
                    "updated_contestants": {
                        "type": "integer",
                        "example": 4
                    },
                    "created_inscriptions": {
                        "type": "integer",
                        "example": 10
                    },
                    "skipped_duplicate_area": {
                        "type": "integer",
                        "example": 2
                    },
                    "errors": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CompetitorRowError"
                        }
                    }
                },
                "type": "object"
            },
            "CompetitorFileResult": {
                "required": [
                    "mensaje"
                ],
                "properties": {
                    "archivo": {
                        "type": "string",
                        "example": "competitors.csv",
                        "nullable": true
                    },
                    "mensaje": {
                        "type": "string",
                        "example": "Archivo procesado correctamente."
                    },
                    "estadisticas": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/CompetitorStats"
                            }
                        ],
                        "nullable": true
                    },
                    "errores": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "example": "Faltan columnas obligatorias."
                                },
                                "missing_headers": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "nullable": true
                                }
                            },
                            "type": "object"
                        },
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "CompetitorUploadResponse": {
                "required": [
                    "message",
                    "resultados"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Procesamiento de archivos CSV finalizado."
                    },
                    "resultados": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CompetitorFileResult"
                        }
                    }
                },
                "type": "object"
            },
            "MissingFileError": {
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "No se recibió ningún archivo. Envíe uno o más archivos CSV."
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "required": [
                    "message",
                    "errors"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Archivo(s) inválido(s). Solo se permiten archivos .csv."
                    },
                    "errors": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "CompetitorUploadForm": {
                "description": "Formulario para subir uno o varios archivos CSV.",
                "properties": {
                    "file": {
                        "description": "Archivo CSV (alternativa a 'files').",
                        "type": "string",
                        "format": "binary"
                    },
                    "files": {
                        "description": "Varios archivos CSV.",
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "binary"
                        }
                    }
                },
                "type": "object"
            }
        },
        "requestBodies": {
            "uploadCsv": {
                "required": true,
                "content": {
                    "multipart/form-data": {
                        "schema": {
                            "$ref": "#/components/schemas/CompetitorUploadForm"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
